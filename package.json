{
  "name": "margin-dashboard-exercise",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n shared,backend,frontend -c gray,blue,magenta \"npm run dev --workspace shared\" \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace backend",
    "seed": "npm run seed --workspace backend",
    "selfcheck": "npm run selfcheck --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
