{
  "name": "@shared/types",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/cjs/types.js",
  "types": "./src/types.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./dist/esm/types.js",
      "require": "./dist/cjs/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}')\"",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}
