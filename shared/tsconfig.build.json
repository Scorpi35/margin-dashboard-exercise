{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/cjs",
    // CommonJS for the backend, which `require`s this package at runtime. The
    // frontend gets the ESM build instead — see tsconfig.build.esm.json.
    "module": "CommonJS",
    "moduleResolution": "Node",
    // Incompatible with a CommonJS emit, and unnecessary here — `types.ts` has
    // no imports to preserve.
    "verbatimModuleSyntax": false,
    // Consumers read types from `src/`, so declarations would only go stale.
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*"]
}
